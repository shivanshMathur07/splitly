# Copy to .env (or .env.local) and fill in. Never commit .env — it's gitignored.
# Locally everything is optional: with no .env the app uses the embedded PGlite
# database (data/pglite) and the dev mailbox at /dev/mailbox.

# ── Database ───────────────────────────────────────────────────────────
# Postgres connection string. On Vercel, the Neon integration sets POSTGRES_URL / DATABASE_URL
# for you. Use Neon's *pooled* URL (host contains "-pooler") with ?sslmode=require.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Max connections per server instance (default 3).
# PG_POOL_MAX=3
# Where the embedded PGlite database lives when DATABASE_URL is unset (default data/pglite).
# PGLITE_DIR=data/pglite

# ── Links ──────────────────────────────────────────────────────────────
# Public base URL used in emailed magic links and auth redirects.
# If unset: on Vercel production it's https://$VERCEL_PROJECT_PRODUCTION_URL, on other Vercel
# deployments https://$VERCEL_URL, and locally it's taken from the request (http://localhost:3000).
# APP_URL=https://splitly.example.com

# ── Email (required in production) ─────────────────────────────────────
# Leave SMTP_HOST empty locally to print emails to the server console and show them at /dev/mailbox.
# In production (NODE_ENV=production) SMTP is required and /dev/mailbox is always off.
# Gmail: use an App Password (Google Account → Security → App passwords), not your real password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM="Splitly <you@gmail.com>"

# Outside production only: force the /dev/mailbox page on (true) or off (false).
# By default it's on only when SMTP is not set.
# DEV_MAILBOX=false
